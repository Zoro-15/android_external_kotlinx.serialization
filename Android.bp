java_library {
    name: "kotlinx_serialization_core",
    host_supported: true,
    sdk_version: "core_current",
    srcs: ["core/jvmMain/src/kotlinx/serialization/**/*.kt"],
    common_srcs: ["core/commonMain/src/kotlinx/serialization/**/*.kt"],
    kotlincflags: [
        "-Xmulti-platform",
        "-Xexpect-actual-classes",
        "-opt-in=kotlin.ExperimentalStdlibApi",
        "-opt-in=kotlin.ExperimentalMultiplatform",
        "-opt-in=kotlinx.serialization.internal.CoreFriendModuleApi",
        "-opt-in=kotlinx.serialization.ExperimentalSerializationApi",
        "-opt-in=kotlinx.serialization.InternalSerializationApi",
    ],
    optimize: {
        proguard_flags_files: ["rules/*"],
        export_proguard_flags_files: true,
    },
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
    manifest: ":kotlinx_serialization_core_manifest",
}

java_library {
    name: "kotlinx_serialization_json",
    host_supported: true,
    sdk_version: "core_current",
    srcs: ["formats/json/jvmMain/src/kotlinx/serialization/**/*.kt"],
    common_srcs: ["formats/json/commonMain/src/kotlinx/serialization/**/*.kt"],
    kotlincflags: [
        "-Xmulti-platform",
        "-Xexpect-actual-classes",
        "-opt-in=kotlin.ExperimentalStdlibApi",
        "-opt-in=kotlin.ExperimentalMultiplatform",
        "-opt-in=kotlinx.serialization.internal.CoreFriendModuleApi",
        "-opt-in=kotlinx.serialization.json.internal.JsonFriendModuleApi",
        "-opt-in=kotlinx.serialization.ExperimentalSerializationApi",
        "-opt-in=kotlinx.serialization.InternalSerializationApi",
    ],
    static_libs: ["kotlinx_serialization_core"],
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
}

// Compute the contents of the MANIFEST.MF file for kotlinx_serialization_core.
// This should produce similar results to the logic in core/build.gradle.
genrule {
    name: "kotlinx_serialization_core_manifest",
    tool_files: ["android_generate_manifest.sh"],
    srcs: [
        "METADATA",
        "core/build.gradle",
    ],
    out: ["kotlinx_serialization_core_manifest.txt"],
    cmd: "$(location android_generate_manifest.sh) $(location METADATA) $(location core/build.gradle) > $(out)",
}

java_test {
    name: "kotlinx_serialization_core_test",
    host_supported: true,
    srcs: ["core/jvmTest/src/**/*.kt"],
    exclude_srcs: [
        // Needs friend support to access kotlinx_serialization_core internals
        "core/jvmTest/src/kotlinx/serialization/CachingTest.kt",
    ],
    common_srcs: ["core/commonTest/src/**/*.kt"],
    exclude_common_srcs: [
        // Needs friend support to access kotlinx_serialization_core internals
        "core/commonTest/src/kotlinx/serialization/ElementMarkerTest.kt",
        "core/commonTest/src/kotlinx/serialization/features/SchemaTest.kt",
        "core/commonTest/src/kotlinx/serialization/PrimitiveSerialDescriptorTest.kt",
        "core/commonTest/src/kotlinx/serialization/SealedGenericClassesTest.kt",
        "core/commonTest/src/kotlinx/serialization/SerializersLookupEnumTest.kt",
        "core/commonTest/src/kotlinx/serialization/SerializersModuleTest.kt",
        "core/commonTest/src/kotlinx/serialization/test/TestHelpers.kt",

        // Needs TestHelpers.kt
        "core/commonTest/src/kotlinx/serialization/InterfaceContextualSerializerTest.kt",
        "core/commonTest/src/kotlinx/serialization/SerialDescriptorBuilderTest.kt",
        "core/commonTest/src/kotlinx/serialization/WrappedSerialDescriptorTest.kt",
    ],
    static_libs: [
        "kotlinx_serialization_core",
        "kotlin-reflect",
        "kotlin-test",
        "junit",
    ],
    kotlincflags: [
        "-Xmulti-platform",
        "-Xexpect-actual-classes",
        "-opt-in=kotlinx.serialization.ExperimentalSerializationApi",
        "-opt-in=kotlinx.serialization.InternalSerializationApi",
    ],
    kotlin_plugins: ["kotlin-serialize-compiler-plugin"],
    test_suites: ["general-tests"],
}
